# === Telemetry / environment ===
APP_ENV=development

# === DEV (test) mode ===
# DEV_MODE=1 relaxes identity resolution and enables the frontend user
# switcher (POST /auth/dev-login, GET /auth/app-config).
#
# It is ALWAYS ignored when APP_ENV=production, so a stray value cannot widen
# the auth surface in a production deployment. Leave it unset/0 to keep the
# strict HMAC verification.
DEV_MODE=1
# Preset used for requests that arrive without a session cookie and initData.
# One of: founder | applicant | empty
DEV_DEFAULT_USER=founder

# === Database ===
POSTGRES_DB=businessclub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/businessclub

# === Telegram Mini App ===
TELEGRAM_BOT_TOKEN=
INIT_DATA_MAX_AGE=86400
SESSION_TTL=86400
SESSION_SECRET=dev-only-insecure-secret

# === HTTP / files ===
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000
FILES_PUBLIC_PREFIX=/api/v1/files
STORAGE_BACKEND=dufs
DUFS_AUTH=NOTEMPTY
STORAGE_BUDGET_BYTES=536870912
