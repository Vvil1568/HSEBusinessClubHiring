FROM node:20-alpine
WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

EXPOSE 3000

# See `Dockerfile`: no Keycloak variables, Telegram handles sign-in.
ARG VITE_API_URL=/api/v1
ARG VITE_USE_MOCK=0

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_USE_MOCK=$VITE_USE_MOCK

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
